# Copy to .env.local. "mock" runs entirely in-process; "aws" uses the AWS adapters.
HOMEWARD_ADAPTERS=mock
HOMEWARD_REGION=eu-north-1
HOMEWARD_TABLE=homeward
# Written by `pnpm aws:setup`:
HOMEWARD_BUCKET=
HOMEWARD_SESSION_SECRET=
# Local development only. On Amplify the SSR compute role supplies credentials.
HOMEWARD_ACCESS_KEY_ID=
HOMEWARD_SECRET_ACCESS_KEY=
# Optional overrides
# HOMEWARD_TEXT_MODEL=eu.amazon.nova-2-lite-v1:0
# HOMEWARD_REKOGNITION_REGION=   (only if your account may call Rekognition)
# HOMEWARD_EMBED_MODEL=amazon.titan-embed-text-v2:0
# Optional secondary AI provider (OpenAI-compatible), used when Bedrock is unavailable
HOMEWARD_AI_BASE_URL=
HOMEWARD_AI_API_KEY=
HOMEWARD_AI_TEXT_MODEL=
HOMEWARD_AI_VISION_MODEL=
